* text=auto

*.cs      text diff=csharp
*.asmdef  text
*.json    text
*.md      text

# Unity YAML. Keep LF so diffs and BugLoop line references match across PCs.
*.unity    text eol=lf
*.prefab   text eol=lf
*.asset    text eol=lf
*.mat      text eol=lf
*.anim     text eol=lf
*.controller text eol=lf
*.meta     text eol=lf

*.png  binary
*.jpg  binary
*.psd  binary
*.tga  binary
*.wav  binary
*.ogg  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
*.fbx  binary
